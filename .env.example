# TrustBreak backend configuration (all optional). Copy to .env and export, e.g.
#   set -a; source .env; set +a      # then start uvicorn from backend/
# Never commit a real .env (it is git-ignored). No secret is hard-coded anywhere.

# AI message analysis -------------------------------------------------------
# Which provider extracts structured fields from the message.
#   gemini    Google Gemini (primary; needs GEMINI_API_KEY)
#   mock      offline rule-based demo extractor, no key, no network (NOT AI)
#   anthropic legacy, still supported (needs ANTHROPIC_API_KEY)
# Precedence: TRUSTBREAK_AI_MODE=mock > TRUSTBREAK_AI_PROVIDER > whichever key is set
# (GEMINI_API_KEY first, then legacy ANTHROPIC_API_KEY) > gemini.
TRUSTBREAK_AI_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/apikey (backend only, never sent to the browser).
GEMINI_API_KEY=

# Model name for the selected provider. If empty, the built-in default for that provider is used
# (gemini: gemini-3.8-flash). Change it here, not in code.
TRUSTBREAK_AI_MODEL=gemini-3.8-flash

# Legacy Anthropic key - only used when TRUSTBREAK_AI_PROVIDER=anthropic (or it is the only key set).
# ANTHROPIC_API_KEY=

# Failure policy (legacy name, still honoured):
# auto (default): use the provider when a key is set; otherwise, or if the call fails / returns
#                 invalid JSON, fall back to the demo extractor - clearly labelled, never as AI
# ai:             provider only - return an error instead of falling back
# mock:           always use the offline demo extractor (wins over TRUSTBREAK_AI_PROVIDER)
TRUSTBREAK_AI_MODE=auto

# Request timeout in seconds (1-120)
TRUSTBREAK_AI_TIMEOUT_SECONDS=20

# Existing settings -----------------------------------------------------------
# TRUSTBREAK_DB_PATH=
# TRUSTBREAK_SEED_DEMO=1
# TRUSTBREAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
