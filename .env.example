# TrustBreak backend configuration (all optional). Copy to .env and export, e.g.
#   set -a; source .env; set +a      # then start uvicorn from backend/
# Never commit a real .env (it is git-ignored). No secret is hard-coded anywhere.

# AI message analysis -------------------------------------------------------
# Anthropic API key. If empty, the app runs in clearly-labelled DEMO (mock) mode.
ANTHROPIC_API_KEY=

# auto (default): use AI when a key is set, otherwise demo mode, and fall back
#                 to demo mode (labelled) if the AI call fails or returns bad JSON
# ai:             AI only - return an error instead of falling back
# mock:           always use the deterministic demo rules (no network)
TRUSTBREAK_AI_MODE=auto

# Model name and request timeout (seconds, 1-120)
TRUSTBREAK_AI_MODEL=claude-sonnet-5-5
TRUSTBREAK_AI_TIMEOUT_SECONDS=20

# Existing settings -----------------------------------------------------------
# TRUSTBREAK_DB_PATH=
# TRUSTBREAK_SEED_DEMO=1
# TRUSTBREAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
